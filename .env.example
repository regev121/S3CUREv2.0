# Point to the existing PostgreSQL database. Schema creation is an explicit setup command.
DATABASE_URL=postgresql+psycopg2://s3cure:REPLACE_ME@127.0.0.1:5432/s3cure
# For a local demo only, DATABASE_URL=sqlite:///./s3cure-local.db also works.
SECRET_KEY=
ENCRYPTION_KEY=
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ADMIN_ALIAS=myminio
# Optional MinIO alias with read-only admin:ServerInfo for drive and uptime metrics.
# MINIO_TELEMETRY_ALIAS=telemetry
MINIO_SCANNER_ACCESS_KEY=scanner
MINIO_SCANNER_SECRET_KEY=
RAW_SCAN_BUCKET=raw-scan
PROCCESSED_SCAN_BUCKET=processed-scan
# Optional: an older reports/ bucket with a separate read-only grant for scanner.
# LEGACY_SCAN_BUCKET=processed-data-bucket
