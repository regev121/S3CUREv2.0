# Use a dedicated runtime role for the existing PostgreSQL database.
DATABASE_URL=postgresql+psycopg2://s3cure_runtime:REPLACE_ME@127.0.0.1:5432/s3cure
# For a local demo only, DATABASE_URL=sqlite:///./s3cure-local.db also works.
# Set DATABASE_SETUP_URL only in the operator's shell for schema, roles, or backfill.
ENCRYPTION_KEY=
S3CURE_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# For HTTPS deployments, use the real frontend origin and set S3CURE_SECURE_COOKIES=true.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ADMIN_ALIAS=myminio
# Set MINIO_OPERATOR_CONFIG_DIR in the operator's shell to locate the privileged alias.
MINIO_ROOT_ACCESS_KEY=minioadmin
# Optional MinIO alias with read-only admin:ServerInfo and admin:StorageInfo for telemetry.
# MINIO_TELEMETRY_ALIAS=telemetry
MINIO_SCANNER_ACCESS_KEY=scanner
MINIO_SCANNER_SECRET_KEY=
MINIO_MANAGER_ACCESS_KEY=s3cure-iam-manager
MINIO_MANAGER_SECRET_KEY=
RAW_SCAN_BUCKET=raw-scan
PROCCESSED_SCAN_BUCKET=processed-scan
# Optional: an older reports/ bucket with a separate read-only grant for scanner.
# LEGACY_SCAN_BUCKET=processed-data-bucket
